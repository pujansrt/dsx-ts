{
  "name": "@pujansrt/dsx-ts",
  "version": "1.0.3",
  "keywords": [ "typescript",
    "bloom filter",
    "dsx",
    "stack",
    "queue",
    "data structure"
  ],
  "license": "MIT",
  "description": "Type-safe data-structure implementations in TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "tsc -w"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pujansrt/dsx-ts.git"
  },
  "author": "pujansrt",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.3",
    "jest-coverage-badges": "^1.1.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
